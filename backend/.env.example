# ChargeX Backend Environment Variables Example
PORT=3000

# MongoDB Connection String (e.g. from MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chargex?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_chargex_2026
JWT_EXPIRATION=7d
JWT_REFRESH_SECRET=your_super_secret_refresh_key_chargex_2026
JWT_REFRESH_EXPIRATION=30d

# Initial Administrator Seed
ADMIN_DEFAULT_EMAIL=admin@chargex.com
ADMIN_DEFAULT_PASSWORD=Admin@123456

# Firebase Push Notifications (Optional: Raw JSON content or path)
FIREBASE_PROJECT_ID=chargex-notifications
# FIREBASE_SERVICE_ACCOUNT={"type": "service_account", ...}

# Virtual numbers (fallback when no virtual-number provider record exists in Admin)
# FIVESIM_API_KEY=your_5sim_api_key
# FIVESIM_BASE_URL=https://5sim.net/v1
# HEROSMS_API_KEY=your_hero_sms_api_key
# HEROSMS_BASE_URL=https://hero-sms.com/stubs/handler_api.php
# VIRTUAL_NUMBER_TTL_MINUTES=20
